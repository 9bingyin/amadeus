{
  "workspace": "workspace",
  "gateway": {
    "inputWindowMs": 700
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "addSource": false
  },
  "model": {
    "provider": "default",
    "id": "gpt-5-mini",
    "reasoningEffort": "medium",
    "contextWindowTokens": 128000
  },
  "providers": {
    "default": {
      "api": "openai-responses",
      "apiKey": "replace-with-openai-api-key",
      "baseURL": "https://api.openai.com/v1",
      "httpVersion": "auto"
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000
  },
  "telegram": {
    "enabled": true,
    "botToken": "123456789:replace-with-telegram-bot-token",
    "allowedUserIDs": [123456789]
  },
  "mcp": {
    "servers": []
  }
}

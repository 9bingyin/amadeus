{
  "telegram": {
    "botToken": "replace-with-botfather-token",
    "allowedUserIds": [123456789],
    "streamResponses": false
  },
  "pi": {
    "command": "pi",
    "args": []
  },
  "memory": {
    "enabled": false,
    "extractionTimeoutMs": 60000,
    "qmd": {
      "enabled": true,
      "command": "qmd",
      "searchTimeoutMs": 60000
    }
  },
  "paths": {
    "stateDir": "~/.amadeus/state",
    "sessionDir": "~/.amadeus/sessions",
    "attachmentsDir": "~/.amadeus/attachments",
    "workspaceDir": "~/.amadeus/workspace",
    "memoryDir": "~/.amadeus/memory"
  }
}

{
  "workspace": "workspace",
  "gateway": {
    "inputWindowMs": 700
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "addSource": false
  },
  "openai": {
    "apiKey": "replace-with-openai-api-key",
    "model": "gpt-5-mini",
    "baseURL": "https://api.openai.com/v1",
    "httpVersion": "auto",
    "reasoningEffort": "medium"
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000
  },
  "telegram": {
    "enabled": true,
    "botToken": "123456789:replace-with-telegram-bot-token",
    "allowedUserIDs": [123456789]
  },
  "mcp": {
    "servers": []
  }
}
